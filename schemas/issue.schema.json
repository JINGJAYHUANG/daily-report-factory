{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/daily-report-factory/issue.schema.json",
  "title": "Daily Report Factory Issue",
  "type": "object",
  "required": [
    "schema_version",
    "publication_id",
    "issue_id",
    "issue_date",
    "generated_at",
    "language",
    "timezone",
    "title",
    "subtitle",
    "status",
    "synthetic",
    "sections",
    "sources",
    "disclosures"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "publication_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "issue_id": {"type": "string", "minLength": 1},
    "issue_date": {"type": "string", "format": "date"},
    "generated_at": {"type": "string", "format": "date-time"},
    "language": {"type": "string", "minLength": 2},
    "timezone": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "subtitle": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "reviewed", "published", "fixture"]},
    "synthetic": {"type": "boolean"},
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "heading", "summary", "evidence", "implications", "actions"]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "publisher", "url", "published_at", "checked_at", "rights", "synthetic"]
      }
    },
    "disclosures": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": true
}
